# --- ElevenLabs voice intake mentor ---
# Agent ID from the ElevenLabs dashboard. Required for the intake widget to render.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_XXXXXXXXXXXXXXXX
# API key used server-side to mint conversation tokens / signed URLs.
# Required if the agent has authentication enabled; recommended either way.
ELEVENLABS_API_KEY=sk_XXXXXXXXXXXXXXXX

# --- Booking ---
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/30min

# --- DynamoDB (intake storage) ---
AWS_REGION=us-east-1
# Use APP_AWS_REGION on hosts such as Amplify that reserve AWS_* names.
APP_AWS_REGION=us-east-1
# Optional for hosts that cannot attach an IAM role/OIDC provider.
APP_AWS_ACCESS_KEY_ID=AKIA...
APP_AWS_SECRET_ACCESS_KEY=...
# Vercel OIDC role; omit locally to use the default AWS credential chain.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/your-vercel-oidc-role
DYNAMODB_TABLE_NAME=your-table-name

# --- TRELLIS image-to-3D lab ---
TRELLIS_DYNAMODB_TABLE_NAME=trellis-lab-dev-jobs
TRELLIS_S3_BUCKET_NAME=trellis-lab-dev-example
TRELLIS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/trellis-lab-dev-jobs
TRELLIS_WORKER_TOKEN=replace-with-a-long-random-secret
TRELLIS_MAX_UPLOAD_BYTES=10485760
